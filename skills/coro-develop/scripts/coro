#!/usr/bin/env bash
# Entry point for the coro-develop skill. Resolves its own location via
# BASH_SOURCE, then runs the skill-local Deno configuration against coroutine.ts.
# Works from any cwd.
set -euo pipefail

declare CONTEXT; CONTEXT="$( cd -P -- "${BASH_SOURCE[0]%/*}" && pwd -P )"; declare -r CONTEXT
[[ -d "${CONTEXT}" && "${CONTEXT##*/}" == "scripts" ]] || {
  printf '%s: %s\n' 'Bad Context' "${CONTEXT}" >&2
  exit 1
}

DENO="${DENO:-deno}"
command -v "${DENO}" >/dev/null 2>&1 || {
  printf 'error: deno not found on PATH\n' >&2
  printf '  install Deno 2.9.6 or newer\n' >&2
  exit 1
}

exec "${DENO}" run --config "${CONTEXT}/../deno.json" --allow-read --allow-write --allow-env --allow-run=claude "${CONTEXT}/coroutine.ts" "$@"
