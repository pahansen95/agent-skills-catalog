#!/usr/bin/env bash
# Create the local runtime environment for the coro-develop skill. The venv
# lives beside coroutine.py so the in-tree launcher can find it.
set -euo pipefail

declare CONTEXT; CONTEXT="$( cd -- "${BASH_SOURCE[0]%/*}" && pwd )"; declare -r CONTEXT
cd "${CONTEXT}"

command -v uv &>/dev/null || { echo 'error: uv is not in PATH' >&2; exit 1; }

PYTHON_VERSION="$(<"${CONTEXT}/.python-version")"
uv venv --python "${PYTHON_VERSION}" --quiet
echo "created coro-develop venv at ${CONTEXT}/.venv"
